# .gitignore for C# / WinUI 3 Poker HUD project

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[bB]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg
# NuGet packages folder can be ignored
# except for the packages folder that contains .NET tool packages
!packages/build/
*.nuget.props
*.nuget.targets

# User-specific files
*.rsuser

# Windows image file caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# Vim temporary files
*.swp
*~

# macOS
.DS_Store

# JetBrains Rider
.idea/

# Misc
*.tmp
*.temp
