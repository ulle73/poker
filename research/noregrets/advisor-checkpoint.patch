+struct JointPrior {
+    combos: Vec<[Card; 2]>,
+    values: Vec<f64>,
+    cumulative: Vec<f64>,
+    total: f64,
+}
+impl JointPrior {
+    fn draw(&self, rng: &mut SmallRng) -> [Card; 2] {
+        let r = rng.random::<f64>() * self.total;
+        let i = self.cumulative.partition_point(|&x| x <= r).min(self.combos.len()-1);
+        self.combos[i]
+    }
+}
+
+/// Product range priors conditioned jointly on card uniqueness. The query
+/// hand is oversampled, never held fixed in every opponent traversal.
+/// Rejection redraws the WHOLE mixture. Returned p/q is proportional to the
+/// normalized joint ratio by one common root constant; suitable for strategy
+/// updates, not a stand-alone normalized EV estimate.
+pub struct JointSampler {
+    n: usize,
+    hero: usize,
+    actual: [Card; 2],
+    actual_probability: f64,
+    focus: f64,
+    board_mask: u64,
+    priors: Vec<JointPrior>,
+    uniform: bool,
+}
+impl JointSampler {
+    pub fn new(weights: Vec<Vec<f64>>, board: &[Card], hero: usize,
+        actual: [Card; 2], focus: f64) -> Result<Self, String> {
+        let n=weights.len();
+        if !(2..=MAX_PLAYERS).contains(&n) || hero>=n || !focus.is_finite() || !(0.0..1.0).contains(&focus) {
+            return Err("invalid joint sampler dimensions or focus".into());
+        }
+        if !matches!(board.len(),0|3|4|5) || board.iter().any(|&c|c>=52) {
+            return Err("invalid joint sampler board".into());
+        }
+        let board_mask=board.iter().fold(0u64,|m,&c|m|(1u64<<c));
+        if board_mask.count_ones() as usize!=board.len() || actual[0]>=52 || actual[1]>=52
+            || actual[0]==actual[1] || actual.iter().any(|&c|board_mask&(1u64<<c)!=0) {
+            return Err("duplicate or blocked known cards".into());
+        }
+        let combos=all_combos();
+        let legal=(52-board.len())*(51-board.len())/2;
+        let mut priors=Vec::with_capacity(n);
+        let mut uniform=true;
+        for row in &weights {
+            if row.len()!=NUM_COMBOS || row.iter().any(|w|!w.is_finite() || *w<0.0) {
+                return Err("invalid range weight".into());
+            }
+            let max=row.iter().zip(&combos).filter(|(_,c)|c.iter().all(|&c|board_mask&(1u64<<c)==0))
+                .map(|(&w,_)|w).fold(0.0f64,f64::max);
+            if max<=0.0 {return Err("range has no legal positive combo".into());}
+            let mut p=JointPrior{combos:Vec::new(),values:Vec::new(),cumulative:Vec::new(),total:0.0};
+            for (&w,&c) in row.iter().zip(&combos) {
+                if w==0.0 || c.iter().any(|&c|board_mask&(1u64<<c)!=0) {continue;}
+                let v=w/max;
+                if v<=0.0 {return Err("range weight dynamic range exceeds f64 support".into());}
+                p.total+=v;
+                p.combos.push(c);p.values.push(v);p.cumulative.push(p.total);
+            }
+            uniform &= p.combos.len()==legal && p.values.iter().all(|v|*v==p.values[0]);
+            priors.push(p);
+        }
+        let actual_i=priors[hero].combos.iter().position(|c|combo_index(c[0],c[1])==combo_index(actual[0],actual[1]))
+            .ok_or("query hand has zero prior mass")?;
+        let actual_probability=priors[hero].values[actual_i]/priors[hero].total;
+        if actual_probability<=0.0 {return Err("query probability underflow".into());}
+        Ok(Self{n,hero,actual,actual_probability,focus,board_mask,priors,uniform})
+    }
+    pub fn apply(&self, h: &mut Hand, rng: &mut SmallRng) -> Result<f64, String> {
+        if h.num_players()!=self.n || h.board().iter().fold(0u64,|m,&c|m|(1u64<<c))!=self.board_mask {
+            return Err("joint sampler used with a different public root".into());
+        }
+        'attempt: for _ in 0..10_000 {
+            let hero=if rng.random::<f64>()<self.focus {self.actual} else {self.priors[self.hero].draw(rng)};
+            let focused=combo_index(hero[0],hero[1])==combo_index(self.actual[0],self.actual[1]);
+            let importance=if focused {
+                self.actual_probability/((1.0-self.focus)*self.actual_probability+self.focus)
+            } else {1.0/(1.0-self.focus)};
+            let mut want=[None;MAX_PLAYERS];want[self.hero]=Some(hero);
+            if !self.uniform {
+                let mut used=self.board_mask|(1u64<<hero[0])|(1u64<<hero[1]);
+                for (seat,slot) in want.iter_mut().enumerate().take(self.n) {
+                    if seat==self.hero {continue;}
+                    let c=self.priors[seat].draw(rng);
+                    let mask=(1u64<<c[0])|(1u64<<c[1]);
+                    if mask&used!=0 {continue 'attempt;}
+                    *slot=Some(c);used|=mask;
+                }
+            }
+            // Uniform priors have the same completion normalizer for every
+            // hero pair; the engine can draw all other cards directly.
+            h.resample_hidden_with(&want,rng);
+            return Ok(importance);
+        }
+        Err("no compatible joint deal after 10000 complete proposals".into())
+    }
+}
