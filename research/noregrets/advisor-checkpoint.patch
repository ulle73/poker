+/// A checkpoint embeds its exact previous policy rather than a mutable path.
+/// Upstream supports one strategic co-training level only.
+#[derive(Serialize, Deserialize)]
+pub(crate) struct SavedStratCtx {
+    blueprint: crate::cfr::Blueprint,
+    rollouts: u32,
+}
+
+impl SavedStratCtx {
+    fn validate(&self) -> std::io::Result<()> {
+        if self.rollouts == 0 || self.blueprint.centroids.as_ref().is_some_and(|c| c.is_strategic()) {
+            return Err(std::io::Error::new(std::io::ErrorKind::InvalidData,
+                "checkpoint requires a non-strategic previous blueprint and positive fingerprint rollouts"));
+        }
+        Ok(())
+    }
+}
