+    #[test]
+    fn advisor_vr_enumerated_expectation_is_unbiased() {
+        // Enumerate every action, rather than relying on convergence or a seed.
+        for sigma in [[0.5, 0.5], [0.1, 0.9], [0.0, 1.0]] {
+            for q in [[0.25, 0.75], [0.8, 0.2], [0.5, 0.5]] {
+                for b in [[1.0f32, 3.0], [-42.0, 70.0], [0.0, 0.0]] {
+                    let child = [-11.0, 23.0];
+                    let exact: f64 = (0..2).map(|i| sigma[i] * child[i]).sum();
+                    let estimate: f64 = (0..2).map(|i|
+                        q[i] * vr_corrected_value(&sigma, &b, i, sigma[i] / q[i], child[i])
+                    ).sum();
+                    assert!((estimate - exact).abs() < 1e-10, "sigma={sigma:?}, q={q:?}, b={b:?}: {estimate} != {exact}");
+                }
+            }
+        }
+    }
