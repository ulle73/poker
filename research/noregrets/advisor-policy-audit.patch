+++ b/src/advisor_audit.rs
@@ -0,0 +1,197 @@
+//! Bounded research-only profile export for an independent finite river oracle.
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use crate::abstraction::{Abstraction,AbsConfig,AbsAction};
+use crate::cards::{Card,parse_card,card_str};
+use crate::cfr::{Trainer,TrainConfig};
+use crate::engine::{Hand,HandConfig,PlayerAction,Street};
+use crate::search::{JointSampler,NUM_COMBOS,combo_index};
+use rand::{SeedableRng,rngs::SmallRng};
+use std::sync::Arc;
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all="camelCase", deny_unknown_fields)]
+pub struct Request {
+    pub board: Vec<String>,
+    pub ranges: Vec<Vec<ExactHand>>,
+    pub investment: u32,
+    pub stack: u32,
+    pub iterations: u64,
+    pub time_budget_ms: u64,
+    pub seed: u64,
+}
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExactHand {pub cards:[String;2],pub weight:f64}
+
+pub fn run(request:&Request)->Result<Value,String> {
+    let n=request.ranges.len();
+    if !(2..=10).contains(&n) || request.investment<2 || request.investment>1_000_000 {
+        return Err("invalid audit player count or investment".into());
+    }
+    if request.stack==0 || request.stack>request.investment {
+        return Err("stack must be positive and no greater than investment in this finite check/jam audit".into());
+    }
+    if request.iterations>2_000_000 || request.time_budget_ms==0 || request.time_budget_ms>120_000 {
+        return Err("audit training budget exceeded".into());
+    }
+    let board=request.board.iter().map(|c|parse_card(c).ok_or("invalid board card".to_string())).collect::<Result<Vec<_>,_>>()?;
+    if board.len()!=5 {return Err("audit requires a river board".into());}
+    let mut mask=0u64;
+    for &c in &board {
+        if mask&(1u64<<c)!=0 {return Err("duplicate board card".into());} mask|=1u64<<c;
+    }
+    let mut weights=vec![vec![0.0;NUM_COMBOS];n];
+    let mut ranges=Vec::<Vec<[Card;2]>>::new();
+    for (p,row) in request.ranges.iter().enumerate() {
+        if row.is_empty() || row.len()>16 {return Err("audit range size must be 1..16".into());}
+        let mut parsed=Vec::new();
+        for hand in row {
+            if !hand.weight.is_finite() || hand.weight<=0.0 || hand.weight>1.0 {return Err("invalid audit weight".into());}
+            let a=parse_card(&hand.cards[0]).ok_or("invalid private card")?;
+            let b=parse_card(&hand.cards[1]).ok_or("invalid private card")?;
+            if a==b || (mask&((1u64<<a)|(1u64<<b)))!=0 {return Err("duplicate or blocked private card".into());}
+            let key=combo_index(a,b);
+            if weights[p][key]>0.0 {return Err("duplicate private combination".into());}
+            weights[p][key]=hand.weight;parsed.push([a,b]);
+        }
+        ranges.push(parsed);
+    }
+    fn choose(ranges:&[Vec<[Card;2]>],p:usize,mask:u64,chosen:&mut Vec<[Card;2]>,visits:&mut usize)->bool {
+        *visits+=1;if *visits>100_000 {return false;}
+        if p==ranges.len() {return true;}
+        for &c in &ranges[p] {
+            let cm=(1u64<<c[0])|(1u64<<c[1]);if cm&mask!=0 {continue;}
+            chosen.push(c);if choose(ranges,p+1,mask|cm,chosen,visits) {return true;}chosen.pop();
+        }
+        false
+    }
+    let mut chosen=Vec::new();let mut visits=0;
+    if !choose(&ranges,0,mask,&mut chosen,&mut visits) {return Err("no compatible audit deal within search budget".into());}
+    let mut cards=chosen.iter().flatten().copied().chain(board.iter().copied()).collect::<Vec<_>>();
+    for c in 0..52u8 {if !cards.contains(&c) {cards.push(c);}}
+    let deck:[Card;52]=cards.try_into().map_err(|_|"invalid audit deck")?;
+    let cfg=TrainConfig{hand:HandConfig{num_players:n,stack:request.investment+request.stack,
+        sb:request.investment/2,bb:request.investment},seed:request.seed,..TrainConfig::default()};
+    let mut root=Hand::new(&cfg.hand,n-1,deck);
+    for _ in 0..3*n {
+        if root.street()==Street::River {break;}
+        if root.is_terminal() {return Err("audit prefix ended early".into());}
+        root.apply(PlayerAction::CheckCall);
+    }
+    if root.street()!=Street::River || root.to_act()!=0 || root.board()!=board
+        || (0..n).any(|p|root.hand_commit(p)!=request.investment || root.stack(p)!=request.stack || root.street_commit(p)!=0) {
+        return Err("native public root differs from requested finite game".into());
+    }
+    let abs=Arc::new(Abstraction::new(AbsConfig::default()));
+    let joint=JointSampler::new(weights,&board,0,root.hole(0),0.5)?;
+    let t=Trainer::new(abs,cfg).with_plus(true).with_current_board(&board);
+    let start=std::time::Instant::now();
+    let sampler=|h:&mut Hand,rng:&mut SmallRng|joint.apply(h,rng);
+    t.run_subgame(&root,&[],request.time_budget_ms,request.iterations,Some(&sampler))?;
+    let mut nodes=Vec::new();
+    walk(&root,&t,&ranges,&mut Vec::new(),"",&mut nodes)?;
+    Ok(serde_json::json!({"protocol":"advisor-native-audit-v1","eligibleForAdvice":false,"goalReady":false,
+        "scope":"Bounded equal-stack river check/jam profile; no generic poker certificate",
+        "request":request,"iterations":t.iterations(),"elapsedMs":start.elapsed().as_millis(),
+        "root":{"actor":root.to_act(),"dealer":root.button(),"pot":root.pot(),
+          "stacks":(0..n).map(|p|root.stack(p)).collect::<Vec<_>>(),
+          "invested":(0..n).map(|p|root.hand_commit(p)).collect::<Vec<_>>(),
+          "bets":(0..n).map(|p|root.street_commit(p)).collect::<Vec<_>>()},"nodes":nodes}))
+}
+
+fn walk(h:&Hand,t:&Trainer,ranges:&[Vec<[Card;2]>],hist:&mut Vec<u8>,public:&str,nodes:&mut Vec<Value>)->Result<(),String> {
+    if h.is_terminal() {return Ok(());}
+    if nodes.len()>=20_000 {return Err("audit public node budget exceeded".into());}
+    let p=h.to_act();let n=h.num_players();let acts=t.abs.abstract_actions(h);
+    let expected=if h.can_check() {vec![AbsAction::CheckCall,AbsAction::AllIn]}
+        else {vec![AbsAction::Fold,AbsAction::CheckCall]};
+    if acts!=expected {return Err("native menu differs from check/jam game".into());}
+    let mut actions=Vec::new();let mut labels=Vec::new();
+    for &a in &acts {
+        let (kind,cost)=match a {
+            AbsAction::Fold=>("fold",0),
+            AbsAction::CheckCall=>if h.can_check() {("check",0)} else {("call",h.to_call().min(h.stack(p)))},
+            AbsAction::AllIn=>("bet",h.stack(p)),
+            _=>return Err("unsupported audit action".into()),
+        };
+        let to=h.street_commit(p)+cost;
+        actions.push(serde_json::json!({"kind":kind,"cost":cost,"to":to,"allIn":cost==h.stack(p),"id":format!("{kind}:{to}")}));
+        labels.push(format!("river:{p}:{kind}:{to}"));
+    }
+    let mut rng=SmallRng::seed_from_u64(0);
+    let rows=ranges[p].iter().map(|&hole| {
+        let bucket=t.card_key(hole,h.board(),&mut rng);
+        let strategy=t.avg_strategy(bucket,hist);
+        serde_json::json!({"cards":[card_str(hole[0]),card_str(hole[1])],"trained":strategy.is_some(),
+            "frequencies":strategy.unwrap_or_else(||vec![0.5,0.5])})
+    }).collect::<Vec<_>>();
+    nodes.push(serde_json::json!({"history":public,"actor":p,"pot":h.pot(),"actions":actions,"rows":rows,
+        "stacks":(0..n).map(|q|h.stack(q)).collect::<Vec<_>>(),"bets":(0..n).map(|q|h.street_commit(q)).collect::<Vec<_>>(),
+        "invested":(0..n).map(|q|h.hand_commit(q)).collect::<Vec<_>>(),"folded":(0..n).map(|q|h.folded(q)).collect::<Vec<_>>() }));
+    for (i,&a) in acts.iter().enumerate() {
+        let mut child=h.clone();child.apply(t.abs.concrete(h,a));hist.push(a.token());
+        let next=if public.is_empty(){labels[i].clone()}else{format!("{public}|{}",labels[i])};
+        walk(&child,t,ranges,hist,&next,nodes)?;hist.pop();
+    }
+    Ok(())
+}
+
+pub fn run_file(input:&str,output:&str)->Result<(),String> {
+    use std::io::Read;
+    let f=std::fs::File::open(input).map_err(|e|e.to_string())?;
+    let mut data=Vec::new();
+    f.take(1_048_577).read_to_end(&mut data).map_err(|e|e.to_string())?;
+    if data.len()>1_048_576 {return Err("audit input exceeds 1 MiB".into());}
+    let request:Request=serde_json::from_slice(&data).map_err(|e|e.to_string())?;
+    let result=run(&request)?;
+    std::fs::write(output,serde_json::to_vec_pretty(&result).map_err(|e|e.to_string())?).map_err(|e|e.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cards::{card_str, parse_card};
+    fn fixture(n:usize)->Request {
+        let board=vec!["Ah","Kd","7c","4s","2h"].into_iter().map(str::to_owned).collect::<Vec<_>>();
+        let blocked=board.iter().map(|c|parse_card(c).unwrap()).collect::<Vec<_>>();
+        let private=(0..52u8).filter(|c|!blocked.contains(c)).take(2*n).collect::<Vec<_>>();
+        Request{board,ranges:private.chunks_exact(2).map(|c|vec![ExactHand{cards:[card_str(c[0]),card_str(c[1])],weight:1.0}]).collect(),
+            investment:100,stack:90,iterations:0,time_budget_ms:1000,seed:395}
+    }
+    #[test]
+    fn advisor_audit_exports_the_real_equal_stack_root_for_all_counts() {
+        for n in 2..=10 {
+            let result=run(&fixture(n)).unwrap();
+            assert_eq!(result["root"]["actor"],0);
+            assert_eq!(result["root"]["dealer"],n-1);
+            assert_eq!(result["root"]["pot"],100*n);
+            assert_eq!(result["root"]["stacks"],serde_json::json!(vec![90;n]));
+            assert_eq!(result["root"]["invested"],serde_json::json!(vec![100;n]));
+            assert_eq!(result["root"]["bets"],serde_json::json!(vec![0;n]));
+            assert_eq!(result["eligibleForAdvice"],false);
+        }
+    }
+    #[test]
+    fn advisor_audit_untrained_rows_are_explicit_in_a_complete_two_player_tree() {
+        let result=run(&fixture(2)).unwrap();
+        let nodes=result["nodes"].as_array().unwrap();
+        assert_eq!(nodes.len(),4);
+        for node in nodes {
+            assert_eq!(node["actions"].as_array().unwrap().len(),2);
+            for row in node["rows"].as_array().unwrap() {
+                assert_eq!(row["trained"],false);
+                assert_eq!(row["frequencies"],serde_json::json!([0.5,0.5]));
+            }
+        }
+    }
+    #[test]
+    fn advisor_audit_rejects_a_different_game_and_duplicate_cards() {
+        let mut request=fixture(2);request.stack=101;
+        assert!(run(&request).unwrap_err().contains("stack must"));
+        request=fixture(2);let duplicate=request.ranges[0][0].clone();request.ranges[0].push(duplicate);
+        assert!(run(&request).unwrap_err().contains("duplicate private"));
+        request=fixture(2);request.board[1]=request.board[0].clone();
+        assert!(run(&request).unwrap_err().contains("duplicate board"));
+    }
+}
