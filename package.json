{
  "name": "poker-gto-advisor",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Offline heads-up poker trainer with DOM capture and measured DCFR strategies",
  "author": "Jonas",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-live-reader.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64",
    "verify:solver": "node scripts/verify-solver.mjs",
    "smoke:desktop": "electron . --smoke-test",
    "verify:multiway": "node scripts/verify-multiway.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "phe": "0.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "jsdom": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "se.pokertrainer.advisor",
    "productName": "Poker GTO Advisor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "docs/licenses/**/*",
      "docs/solver-provenance.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Poker-GTO-Advisor-${version}-Windows.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
